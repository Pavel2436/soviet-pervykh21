    function bindDirectionChatEvents() {
        const user = getUsers().find(u => u.id === getSession().userId);
        let currentDirection = user.leaderDirections[0];
        const select = document.getElementById('dirChatSelect');
        const msgBox = document.getElementById('dirMessagesBox');
        const input = document.getElementById('dirChatInput');
        const sendBtn = document.getElementById('sendDirChatBtn');
        const addBtn = document.getElementById('addToDirChatBtn');
        const addUserSelect = document.getElementById('dirChatAddUser');
        const membersList = document.getElementById('dirChatMembersList');

        function loadMembers() {
            const members = getDirectionChatMembers().filter(m => m.direction === currentDirection);
            const memberUsers = members.map(m => getUsers().find(u => u.id === m.userId)).filter(Boolean);
            membersList.innerHTML = memberUsers.length ? memberUsers.map(u => `<span style="background:var(--bg); padding:2px 8px; border-radius:10px; margin:2px; display:inline-block;">${escapeHTML(u.fullName||u.name)} <button class="btn btn-sm btn-danger" style="padding:0 4px;font-size:0.6rem;" data-remove="${u.id}">×</button></span>`).join('') : 'Нет участников';
            
            // Добавляем обработчики удаления
            membersList.querySelectorAll('[data-remove]').forEach(btn => {
                btn.onclick = () => {
                    const removeId = parseInt(btn.dataset.remove);
                    const updatedMembers = getDirectionChatMembers().filter(m => !(m.direction === currentDirection && m.userId === removeId));
                    saveDirectionChatMembers(updatedMembers);
                    loadMembers();
                    showToast('Участник удалён из чата', 'success');
                };
            });
        }

        function loadMessages() {
            const members = getDirectionChatMembers().filter(m => m.direction === currentDirection).map(m => m.userId);
            members.push(user.id); // Лидер всегда видит свои сообщения
            
            const msgs = getMessages().filter(m => m.direction === currentDirection && members.includes(m.from)).sort((a,b) => new Date(a.date) - new Date(b.date));
            msgBox.innerHTML = msgs.map(m => {
                const u = getUsers().find(u => u.id === m.from);
                return `<div class="msg"><strong>${escapeHTML(u?.fullName||u?.name||'—')}</strong>: <span class="msg-text">${escapeHTML(m.text)}</span><div style="font-size:0.7rem;color:var(--text-light);">${formatDate(m.date)}</div></div>`;
            }).join('');
            msgBox.scrollTop = msgBox.scrollHeight;
        }

        select.onchange = () => { currentDirection = select.value; loadMembers(); loadMessages(); };
        
        addBtn.onclick = () => {
            const newUserId = parseInt(addUserSelect.value);
            if (!newUserId) return;
            const members = getDirectionChatMembers();
            if (members.some(m => m.direction === currentDirection && m.userId === newUserId)) {
                showToast('❌ Участник уже в чате', 'error');
                return;
            }
            members.push({ id: genId(), direction: currentDirection, userId: newUserId, addedBy: user.id });
            saveDirectionChatMembers(members);
            loadMembers();
            showToast('✅ Участник добавлен', 'success');
        };
        
        sendBtn.onclick = () => {
            if (!input.value.trim()) return;
            const msgs = getMessages();
            msgs.push({ id: genId(), from: user.id, direction: currentDirection, text: input.value.trim(), date: new Date().toISOString() });
            saveMessages(msgs);
            input.value = '';
            loadMessages();
        };
        
        loadMembers();
        loadMessages();
    }

