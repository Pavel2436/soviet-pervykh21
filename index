<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=yes">
    <title>Совет Первых Регионального отделения</title>
    <style>
        :root {
            --primary: #D4002A; --primary-dark: #A8001E; --primary-light: #FF1F4B;
            --white: #FFFFFF; --bg: #F4F5F9; --card-bg: #FFFFFF;
            --text: #1A1A2E; --text-light: #555; --border: #E0E2EA;
            --shadow: 0 4px 24px rgba(0,0,0,0.07); --radius: 16px;
            --transition: 0.25s; --font: 'Segoe UI', 'Inter', sans-serif;
            --header-text: #FFFFFF; --btn-primary-text: #FFFFFF;
        }
        body.theme-dark {
            --bg: #1A1A2E; --card-bg: #2C2C3A; --text: #E0E0E0;
            --text-light: #AAAAAA; --border: #444; --shadow: 0 4px 24px rgba(0,0,0,0.3);
        }
        body.primary-blue { --primary: #0039A6; --primary-dark: #002277; --primary-light: #1A5FDB; }
        body.primary-red { --primary: #D4002A; --primary-dark: #A8001E; --primary-light: #FF1F4B; }
        body.primary-white {
            --primary: #FFFFFF; --primary-dark: #E0E0E0; --primary-light: #F5F5F5;
            --header-text: #1A1A2E; --btn-primary-text: #1A1A2E; --white: #1A1A2E;
        }
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: var(--font); background: var(--bg); color: var(--text);
            display: flex; align-items: center; justify-content: center;
            min-height: 100vh; padding: 10px; transition: background-color 0.3s, color 0.3s;
        }
        .app-container {
            width: 100%; max-width: 1300px; background: var(--card-bg);
            border-radius: 20px; box-shadow: 0 12px 40px rgba(0,0,0,0.12);
            display: flex; flex-direction: column; max-height: 95vh; overflow: hidden;
        }
        .app-header {
            background: linear-gradient(135deg, var(--primary), var(--primary-dark));
            color: var(--header-text); padding: 14px 20px;
            display: flex; align-items: center; gap: 12px; flex-shrink: 0; flex-wrap: wrap;
        }
        .header-emblem { width: 44px; height: 44px; border-radius: 50%; overflow: hidden; flex-shrink: 0; }
        .header-emblem img { width: 100%; height: 100%; object-fit: cover; }
        .header-text { flex: 1; min-width: 180px; }
        .header-title { font-size: 1.2rem; font-weight: 800; text-transform: uppercase; }
        .header-subtitle { font-size: 0.7rem; opacity: 0.85; }
        .header-actions { display: flex; align-items: center; gap: 6px; flex-shrink: 0; flex-wrap: wrap; }
        .btn-icon { background: transparent; border: none; color: var(--header-text); font-size: 1.2rem; cursor: pointer; padding: 6px; border-radius: 50%; }
        .btn-icon:hover { background: rgba(255,255,255,0.2); }
        .btn-logout { background: rgba(255,255,255,0.2); border: 1.5px solid rgba(255,255,255,0.4); color: var(--header-text); padding: 8px 14px; border-radius: 20px; cursor: pointer; font-weight: 600; font-size: 0.8rem; white-space: nowrap; }
        .user-badge, .admin-badge { padding: 6px 12px; border-radius: 20px; font-weight: 600; font-size: 0.8rem; white-space: nowrap; }
        .user-badge { background: rgba(255,255,255,0.2); }
        .admin-badge { background: #FFD700; color: #1A1A2E; }
        .role-badge { padding: 6px 12px; border-radius: 20px; font-weight: 600; font-size: 0.8rem; white-space: nowrap; cursor: pointer; border: 2px solid transparent; }
        .leader-badge { background: #FFD700; color: #1A1A2E; }

        .app-body { flex: 1; overflow-y: auto; padding: 12px 14px; display: flex; flex-direction: column; gap: 16px; }

        .tabs { display: none; gap: 6px; flex-wrap: wrap; border-bottom: 2px solid var(--border); }
        .tab-select { display: block; width: 100%; padding: 12px; border-radius: 12px; border: 2px solid var(--border); font-family: var(--font); font-size: 1rem; background: var(--card-bg); color: var(--text); margin-bottom: 8px; }

        .tab-btn {
            padding: 10px 16px; border: none; background: transparent;
            font-weight: 600; font-size: 0.85rem; cursor: pointer;
            border-radius: 10px 10px 0 0; color: var(--text-light);
        }
        .tab-btn.active { background: var(--card-bg); color: var(--primary); border-bottom: 3px solid var(--primary); }

        .card { background: var(--card-bg); border-radius: var(--radius); padding: 16px; box-shadow: var(--shadow); border: 1px solid var(--border); margin-bottom: 12px; }

        .form-row { display: flex; flex-wrap: wrap; gap: 8px; align-items: flex-end; background: var(--bg); padding: 14px; border-radius: 12px; border: 1px dashed var(--border); margin-bottom: 12px; flex-direction: column; }
        .form-group { display: flex; flex-direction: column; gap: 4px; flex: 1 1 100%; width: 100%; }
        .form-group label { font-weight: 600; font-size: 0.7rem; text-transform: uppercase; color: var(--text-light); }
        .form-group input, .form-group select, .form-group textarea {
            padding: 10px 14px; border: 2px solid var(--border); border-radius: 20px;
            font-family: var(--font); font-size: 0.9rem; background: var(--card-bg); color: var(--text); width: 100%;
        }
        .btn { padding: 10px 18px; border-radius: 25px; font-weight: 700; cursor: pointer; border: none; font-family: var(--font); font-size: 0.9rem; white-space: nowrap; width: 100%; text-align: center; margin-top: 4px; }
        .btn-primary { background: var(--primary); color: var(--btn-primary-text); }
        .btn-danger { background: #FFEBEE; color: #C62828; border: 1px solid #FFCDD2; }
        .btn-success { background: #4CAF50; color: #fff; }
        .btn-warning { background: #FF9800; color: #fff; }
        .btn-sm { padding: 4px 10px; font-size: 0.7rem; width: auto; }

        .table-wrapper { overflow-x: auto; border-radius: 10px; border: 1px solid var(--border); }
        table { width: 100%; border-collapse: collapse; font-size: 0.85rem; }
        th, td { padding: 10px 12px; border-bottom: 1px solid var(--border); text-align: left; }
        thead { background: var(--bg); }

        .grade-badge { padding: 4px 10px; border-radius: 20px; font-weight: 700; font-size: 0.8rem; display: inline-block; min-width: 40px; text-align: center; }
        .grade-4 { background: #00BCD4; color: #fff; } .grade-3 { background: #4CAF50; color: #fff; }
        .grade-2 { background: #FFEB3B; color: #333; } .grade-1 { background: #FF9800; color: #fff; }
        .grade-0 { background: #F44336; color: #fff; }
        .blurred { filter: blur(5px); user-select: none; }

        .toast { position: fixed; bottom: 20px; right: 20px; background: #1A1A2E; color: #fff; padding: 12px 20px; border-radius: 30px; z-index: 9999; opacity: 0; transform: translateY(20px); transition: 0.3s; font-size: 0.9rem; }
        .toast.show { opacity: 1; transform: translateY(0); }
        .toast.success { background: #2E7D32; } .toast.error { background: #C62828; }

        .modal-overlay { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); display: flex; align-items: center; justify-content: center; z-index: 1000; }
        .modal-content { background: var(--card-bg); border-radius: 16px; padding: 20px; max-width: 500px; width: 90%; box-shadow: 0 8px 30px rgba(0,0,0,0.3); color: var(--text); max-height: 80vh; overflow-y: auto; }

        .sub-tabs { display: flex; gap: 6px; margin-bottom: 16px; flex-wrap: wrap; }
        .sub-tab-btn {
            padding: 8px 16px; border: none; background: var(--bg);
            font-weight: 600; font-size: 0.8rem; cursor: pointer; border-radius: 20px;
            color: var(--text-light);
        }
        .sub-tab-btn.active { background: var(--primary); color: #fff; }

        .chat-container { display: flex; gap: 10px; height: 60vh; }
        .user-list { width: 35%; overflow-y: auto; border-right: 1px solid var(--border); padding-right: 8px; }
        .user-list-item { padding: 8px; cursor: pointer; border-radius: 8px; display: flex; justify-content: space-between; align-items: center; }
        .user-list-item:hover { background: var(--bg); }
        .chat-area { flex: 1; display: flex; flex-direction: column; }
        .messages-box { flex: 1; overflow-y: auto; border: 1px solid var(--border); border-radius: 8px; padding: 8px; margin-bottom: 8px; }
        .msg { margin-bottom: 6px; }
        .msg.mine { text-align: right; }
        .msg-text { display: inline-block; padding: 6px 12px; border-radius: 18px; background: var(--bg); max-width: 80%; }
        .post-card { background: var(--bg); border-radius: 12px; padding: 12px; margin-top: 8px; }
        .gallery-img { width: 80px; height: 80px; object-fit: cover; border-radius: 8px; margin: 4px; }

        @media (min-width: 768px) {
            .tabs { display: flex; }
            .tab-select { display: none; }
            .form-row { flex-direction: row; flex-wrap: wrap; }
            .form-group { flex: 1 1 calc(50% - 8px); width: auto; }
            .btn { width: auto; margin-top: 0; }
        }
        @media (min-width: 1025px) {
            .form-group { flex: 1 1 200px; }
        }
    </style>
</head>
<body>
<div class="app-container" id="appContainer">
    <header class="app-header">
        <div class="header-emblem"><img src="https://static.life.ru/publications/2023/3/28/657401526268.0573-900x.jpeg" alt="Логотип"></div>
        <div class="header-text">
            <div class="header-title">Совет Первых Регионального отделения</div>
            <div class="header-subtitle">Чувашская Республика</div>
        </div>
        <div class="header-actions" id="headerActions"></div>
    </header>
    <div class="app-body" id="appBody"></div>
</div>
<div class="toast" id="toast"></div>

<script type="module">
    import { initializeApp } from "https://www.gstatic.com/firebasejs/10.12.2/firebase-app.js";
    import { getDatabase, ref, get, set } from "https://www.gstatic.com/firebasejs/10.12.2/firebase-database.js";

    const firebaseConfig = {
        apiKey: "AIzaSyB8uD5E5A2NOKqrNPTynsCT-RUdmSH5XSs",
        authDomain: "rkyf-ea1a6.firebaseapp.com",
        databaseURL: "https://rkyf-ea1a6-default-rtdb.europe-west1.firebasedatabase.app",
        projectId: "rkyf-ea1a6",
        storageBucket: "rkyf-ea1a6.firebasestorage.app",
        messagingSenderId: "33784384905",
        appId: "1:33784384905:web:12dbf7356ec7f766856558"
    };

    const app = initializeApp(firebaseConfig);
    const db = getDatabase(app);

    let DISTRICTS = ['город Чебоксары','город Новочебоксарск','Алатырский муниципальный округ','Аликовский муниципальный округ','Батыревский муниципальный округ','Вурнарский муниципальный округ','Ибресинский муниципальный округ','Канашский муниципальный округ','Козловский муниципальный округ','Комсомольский муниципальный округ','Красноармейский муниципальный округ','Красночетайский муниципальный округ','Мариинско-Посадский муниципальный округ','Моргаушский муниципальный округ','Порецкий муниципальный округ','Урмарский муниципальный округ','Цивильский муниципальный округ','Чебоксарский муниципальный округ','Шемуршинский муниципальный округ','Шумерлинский муниципальный округ','Ядринский муниципальный округ','Яльчикский муниципальный округ','Янтиковский муниципальный округ'];
    
    const cache = {
        users: [], grades: [], news: [], tasks: [],
        taskCompletions: [], feedback: [], disputes: [],
        notifications: [], settings: { theme: 'light', primaryColor: 'red' },
        messages: [], announcements: [], districts: [], directionChatMembers: []
    };

    const DB_PATHS = {
        users: 'users', grades: 'grades', news: 'news', tasks: 'tasks',
        taskCompletions: 'taskCompletions', feedback: 'feedback',
        disputes: 'disputes', notifications: 'notifications', settings: 'settings',
        messages: 'messages', announcements: 'announcements', districts: 'districts',
        directionChatMembers: 'directionChatMembers'
    };

    const DIRECTIONS = ['Расскажи о главном!','Береги планету!','Благо твори!','Учись и познавай!','Умей дружить!','Открывай страну!','Служи Отечеству!','Найди призвание!','Достигай и побеждай!','Дерзай и открывай!'];
    const GRADE_CATEGORIES = ['Работа в рабочих группах','Мероприятия','Собрания','Очные встречи','Индивидуальная помощь','Работа в направлении'];

    const appBody = document.getElementById('appBody');
    const headerActions = document.getElementById('headerActions');
    const toast = document.getElementById('toast');

    function showToast(msg, type='') {
        toast.textContent = msg; toast.className = 'toast ' + type + ' show';
        clearTimeout(toast._timeout);
        toast._timeout = setTimeout(() => toast.classList.remove('show'), 2500);
    }
    function escapeHTML(s) { const d = document.createElement('div'); d.textContent = s; return d.innerHTML; }
    function genId() { return Date.now() + '_' + Math.random().toString(36).substr(2,6); }
    function formatDate(iso) {
        const d = new Date(iso);
        return `${String(d.getDate()).padStart(2,'0')}.${String(d.getMonth()+1).padStart(2,'0')}.${d.getFullYear()} ${String(d.getHours()).padStart(2,'0')}:${String(d.getMinutes()).padStart(2,'0')}`;
    }

    async function loadCache(key) {
        const snap = await get(ref(db, DB_PATHS[key]));
        return snap.exists() ? snap.val() : null;
    }
    async function saveCache(key, value) {
        cache[key] = value;
        await set(ref(db, DB_PATHS[key]), value).catch(e => console.warn('Firebase save error:', e));
    }

    function getUsers() {
        cache.users.forEach(u => {
            if (!u.leaderDirections) u.leaderDirections = [];
            if (!u.fullName) u.fullName = '';
            if (!u.district) u.district = '';
            if (!u.email) u.email = '';
            if (!u.photoURL) u.photoURL = '';
            if (!u.socialLinks) u.socialLinks = { tg: '', vk: '', max: '' };
            if (!u.posts) u.posts = [];
        });
        return cache.users;
    }
    async function saveUsers(u) { await saveCache('users', u); }
    function getGrades() { return cache.grades; }
    async function saveGrades(g) { await saveCache('grades', g); }
    function getNews() { return cache.news; }
    async function saveNews(n) { await saveCache('news', n); }
    function getTasks() { return cache.tasks; }
    async function saveTasks(t) { await saveCache('tasks', t); }
    function getTaskCompletions() { return cache.taskCompletions; }
    async function saveTaskCompletions(tc) { await saveCache('taskCompletions', tc); }
    function getFeedback() { return cache.feedback; }
    async function saveFeedback(f) { await saveCache('feedback', f); }
    function getDisputes() { return cache.disputes; }
    async function saveDisputes(d) { await saveCache('disputes', d); }
    function getNotifications() { return cache.notifications; }
    async function saveNotifications(n) { await saveCache('notifications', n); }
    function getSettings() { return cache.settings; }
    async function saveSettings(s) { await saveCache('settings', s); }
    function getMessages() { return cache.messages; }
    async function saveMessages(m) { await saveCache('messages', m); }
    function getAnnouncements() { return cache.announcements; }
    async function saveAnnouncements(a) { await saveCache('announcements', a); }
    function getDirectionChatMembers() { return cache.directionChatMembers; }
    async function saveDirectionChatMembers(d) { await saveCache('directionChatMembers', d); }
    function getSession() { return JSON.parse(localStorage.getItem('session') || 'null'); }
    function saveSession(s) { s ? localStorage.setItem('session', JSON.stringify(s)) : localStorage.removeItem('session'); }

    function applySettings(s) {
        document.body.classList.toggle('theme-dark', s.theme === 'dark');
        document.body.classList.remove('primary-red','primary-blue','primary-white');
        document.body.classList.add('primary-' + s.primaryColor);
    }

    function createInitialUsers() {
        const admins = [
            'Лидер01Первый','Наставник02Второй','Капитан03Третий','Организатор04Четвертый','Вдохновитель05Пятый',
            'Первопроходец06Шестой','Мастер07Седьмой','Энтузиаст08Восьмой','Творец09Девятый','Созидатель10Десятый',
            'Стратег11Одиннадцатый','Аналитик12Двенадцатый','Координатор13Тринадцатый','Модератор14Четырнадцатый','Куратор15Пятнадцатый'
        ];
        const users = [];
        admins.forEach((p,i) => users.push({ id: i, login: 'admin'+String(i+1).padStart(2,'0'), password: p, name: 'Администратор '+(i+1), role: 'admin', fullName: '', joinDate: '', district: '', leaderDirections: [], email: '', photoURL: '', socialLinks: {tg:'',vk:'',max:''}, posts: [] }));
        for (let i=1; i<=150; i++) {
            const num = String(i).padStart(3,'0');
            users.push({ id: i+15, login: 'участник'+num, password: 'пароль'+num, name: 'Участник '+num, role: 'user', fullName: '', joinDate: '', district: '', leaderDirections: [], email: '', photoURL: '', socialLinks: {tg:'',vk:'',max:''}, posts: [] });
        }
        return users;
    }

    async function addMissingUsers() {
        const users = getUsers();
        const existingLogins = new Set(users.map(u => u.login));
        const existingIds = new Set(users.map(u => u.id));
        
        let addedAdmins = 0;
        for (let i = 0; i < 15; i++) {
            const login = 'admin' + String(i+1).padStart(2,'0');
            if (!existingLogins.has(login)) {
                const admins = [
                    'Лидер01Первый','Наставник02Второй','Капитан03Третий','Организатор04Четвертый','Вдохновитель05Пятый',
                    'Первопроходец06Шестой','Мастер07Седьмой','Энтузиаст08Восьмой','Творец09Девятый','Созидатель10Десятый',
                    'Стратег11Одиннадцатый','Аналитик12Двенадцатый','Координатор13Тринадцатый','Модератор14Четырнадцатый','Куратор15Пятнадцатый'
                ];
                const newId = existingIds.size > 0 ? Math.max(...existingIds) + 1 : i;
                users.push({ id: newId, login: login, password: admins[i], name: 'Администратор '+(i+1), role: 'admin', fullName: '', joinDate: '', district: '', leaderDirections: [], email: '', photoURL: '', socialLinks: {tg:'',vk:'',max:''}, posts: [] });
                existingLogins.add(login);
                existingIds.add(newId);
                addedAdmins++;
            }
        }
        
        let addedUsers = 0;
        for (let i = 1; i <= 150; i++) {
            const num = String(i).padStart(3,'0');
            const login = 'участник' + num;
            if (!existingLogins.has(login)) {
                const newId = Math.max(...existingIds) + 1;
                users.push({ id: newId, login: login, password: 'пароль'+num, name: 'Участник '+num, role: 'user', fullName: '', joinDate: '', district: '', leaderDirections: [], email: '', photoURL: '', socialLinks: {tg:'',vk:'',max:''}, posts: [] });
                existingLogins.add(login);
                existingIds.add(newId);
                addedUsers++;
            }
        }
        
        if (addedAdmins > 0 || addedUsers > 0) {
            await saveUsers(users);
            showToast(`✅ Добавлено: ${addedAdmins} админов, ${addedUsers} участников`, 'success');
        } else {
            showToast('ℹ️ Все пользователи уже существуют (15 админов, 150 участников)', 'success');
        }
        
        return { addedAdmins, addedUsers };
    }

    async function initializeData() {
        for (const key of Object.keys(DB_PATHS)) {
            const data = await loadCache(key);
            if (data) {
                cache[key] = data;
            } else {
                if (key === 'users') {
                    const users = createInitialUsers();
                    await saveCache('users', users);
                } else if (key === 'districts') {
                    await saveCache('districts', DISTRICTS);
                } else if (key === 'settings') {
                    await saveCache('settings', { theme: 'light', primaryColor: 'red' });
                } else {
                    await saveCache(key, []);
                }
            }
        }
        if (cache.districts?.length) DISTRICTS = cache.districts;
    }

    function renderLogin(error='') {
        renderHeader(null);
        appBody.innerHTML = `
            <div style="display:flex;align-items:center;justify-content:center;flex:1;">
                <div class="card" style="max-width:440px;width:100%;text-align:center;">
                    <h2>Вход</h2>
                    <form id="loginForm">
                        <div class="form-group"><label>Логин</label><input type="text" id="loginInput" required></div>
                        <div class="form-group" style="position:relative;"><label>Пароль</label><input type="password" id="passInput" required><button type="button" class="password-toggle" id="togglePass">👁️</button></div>
                        <button class="btn btn-primary" style="width:100%;">Войти</button>
                        <div id="loginError" style="color:red;">${escapeHTML(error)}</div>
                    </form>
                </div>
            </div>`;
        document.getElementById('togglePass').onclick = () => {
            const p = document.getElementById('passInput');
            p.type = p.type === 'password' ? 'text' : 'password';
            document.getElementById('togglePass').textContent = p.type === 'password' ? '👁️' : '🙈';
        };
        document.getElementById('loginForm').onsubmit = e => {
            e.preventDefault();
            const login = document.getElementById('loginInput').value.trim();
            const pass = document.getElementById('passInput').value.trim();
            const user = getUsers().find(u => u.login === login && u.password === pass);
            if (user) { saveSession({ userId: user.id, role: user.role, activeRole: 'user' }); renderDashboard(); showToast('✅ Добро пожаловать!', 'success'); }
            else document.getElementById('loginError').textContent = '❌ Неверные данные';
        };
    }

    function renderHeader(session) {
        const settingsBtn = '<button class="btn-icon" onclick="window._openSettingsModal()">⚙️</button>';
        if (!session) { headerActions.innerHTML = settingsBtn; return; }
        const user = getUsers().find(u => u.id === session.userId);
        if (!user) { headerActions.innerHTML = settingsBtn; return; }
        let roleHtml = '';
        if (user.role === 'admin') {
            roleHtml = '<span class="admin-badge">👑 Администратор</span>';
        } else {
            const isActiveLeader = session.activeRole === 'leader' && user.leaderDirections?.length;
            roleHtml = `<span class="role-badge ${isActiveLeader ? 'leader-badge' : 'user-badge'}" id="switchRoleBtn" style="cursor:pointer;">${isActiveLeader ? '🎯 Лидер' : '👤 Участник'}</span>`;
        }
        headerActions.innerHTML = roleHtml + '<button class="btn-logout" onclick="window._logout()">🚪 Выйти</button>' + settingsBtn;
        const switchBtn = document.getElementById('switchRoleBtn');
        if (switchBtn) {
            switchBtn.onclick = () => {
                const sess = getSession();
                sess.activeRole = sess.activeRole === 'leader' ? 'user' : 'leader';
                saveSession(sess); renderDashboard(); showToast(sess.activeRole === 'leader' ? '🎯 Режим лидера' : '👤 Режим участника', 'success');
            };
        }
    }

    function renderDashboard() {
        const session = getSession();
        if (!session) return renderLogin();
        const user = getUsers().find(u => u.id === session.userId);
        if (!user) return renderLogin();
        renderHeader(session);

        const isLeader = user.leaderDirections?.length && session.activeRole === 'leader';
        let tabs = [];
        if (user.role === 'admin') {
            tabs = ['📊 Оценки','📰 Новости','📋 Задания','💬 Обратная связь','📈 Сводка','👥 Пользователи','⚠️ Оспаривания','🏙️ Округа','👤 Профиль','💬 Сообщения'];
        } else if (isLeader) {
            tabs = ['🎯 Лидерство','📰 Новости','📋 Задания','💬 Обратная связь','💬 Чат направления','👤 Профиль','💬 Сообщения'];
        } else {
            tabs = ['📊 Оценки','📰 Новости','📋 Задания','💬 Обратная связь','🏆 Рейтинг','👤 Профиль','💬 Сообщения'];
        }

        appBody.innerHTML = `
            <select class="tab-select" id="tabSelect">${tabs.map((t,i) => `<option value="${i}">${t}</option>`).join('')}</select>
            <div class="tabs" id="tabNav">${tabs.map((t,i) => `<button class="tab-btn" data-tab="${i}">${t}</button>`).join('')}</div>
            <div class="tab-content" id="tabContent"></div>`;

        const select = document.getElementById('tabSelect');
        const btns = document.querySelectorAll('.tab-btn');

        function switchTab(idx) {
            btns.forEach((b,i) => b.classList.toggle('active', i===idx));
            if (select) select.value = idx;
            const content = document.getElementById('tabContent');
            const tabName = tabs[idx];
            if (tabName.includes('Оценки')) content.innerHTML = renderGradesTab();
            else if (tabName.includes('Новости')) content.innerHTML = renderNewsTab();
            else if (tabName.includes('Задания')) content.innerHTML = renderTasksTab();
            else if (tabName.includes('Обратная связь')) content.innerHTML = renderFeedbackTab();
            else if (tabName.includes('Сводка')) content.innerHTML = renderSummaryTab();
            else if (tabName.includes('Пользователи')) content.innerHTML = renderUsersTab();
            else if (tabName.includes('Оспаривания')) content.innerHTML = renderDisputesTab();
            else if (tabName.includes('Округа')) content.innerHTML = renderDistrictsTab();
            else if (tabName.includes('Рейтинг')) content.innerHTML = renderPublicRating();
            else if (tabName.includes('Лидерство')) content.innerHTML = renderLeaderTab();
            else if (tabName.includes('Чат направления')) content.innerHTML = renderDirectionChatTab();
            else if (tabName.includes('Профиль')) content.innerHTML = renderProfileTab();
            else if (tabName.includes('Сообщения')) content.innerHTML = renderMessagesTab();
            bindTabEvents(idx);
        }

        select?.addEventListener('change', () => switchTab(parseInt(select.value)));
        btns.forEach(b => b.addEventListener('click', () => switchTab(parseInt(b.dataset.tab))));
        switchTab(0);
        if (user.role === 'user') checkUnseenNotifications(session.userId);
    }

