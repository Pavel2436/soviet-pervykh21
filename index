    // ====== ПУБЛИЧНЫЙ РЕЙТИНГ (только участники с оценками) ======
    function renderPublicRating() {
        const users = getUsers().filter(u => u.role === 'user');
        const grades = getGrades();
        const usersWithGrades = users.filter(u => grades.some(g => g.userId === u.id));
        const rows = usersWithGrades.map(u => {
            const userGrades = grades.filter(g => g.userId === u.id);
            const avg = userGrades.length ? (userGrades.reduce((s,g)=>s+g.grade,0)/userGrades.length).toFixed(2) : '—';
            return { user: u, avg, count: userGrades.length };
        }).sort((a,b) => {
            if (a.avg === '—') return 1;
            if (b.avg === '—') return -1;
            return parseFloat(b.avg) - parseFloat(a.avg);
        });
        const isAdmin = getSession()?.role === 'admin';
        return `
        <div class="card">
            <div class="card-header">🏆 Общий рейтинг (только участники с оценками)</div>
            ${rows.length ? `<div class="table-wrapper"><table>
                <thead><tr><th>№</th><th>Участник</th><th>Округ</th><th>Средний балл</th><th>Оценок</th></tr></thead>
                <tbody>${rows.map((r,i) => `<tr>
                    <td>${i+1}</td>
                    <td>${escapeHTML(r.user.fullName||r.user.name)}</td>
                    <td>${escapeHTML(r.user.district||'—')}</td>
                    <td class="${!isAdmin && r.avg !== '—' && parseFloat(r.avg) < 1.5 ? 'blurred' : ''}">${r.avg}</td>
                    <td>${r.count}</td>
                </tr>`).join('')}</tbody>
            </table></div>` : '<div class="empty-state">Нет участников с оценками</div>'}
        </div>`;
    }

    // ====== СВОДКА (админ) ======
    function renderSummaryTab() {
        const users = getUsers().filter(u => u.role === 'user');
        const grades = getGrades();
        const districts = ['Все', ...DISTRICTS];
        const districtOptions = districts.map(d => `<option value="${d}">${d}</option>`).join('');
        const usersWithGrades = users.filter(u => grades.some(g => g.userId === u.id));

        function buildRating(filterDistrict = 'Все') {
            const filtered = filterDistrict === 'Все' ? usersWithGrades : usersWithGrades.filter(u => u.district === filterDistrict);
            const rows = filtered.map(u => {
                const userGrades = grades.filter(g => g.userId === u.id);
                const avg = userGrades.length ? (userGrades.reduce((s,g)=>s+g.grade,0)/userGrades.length).toFixed(2) : '—';
                return { user: u, avg, count: userGrades.length };
            }).sort((a,b) => {
                if (a.avg === '—') return 1;
                if (b.avg === '—') return -1;
                return parseFloat(b.avg) - parseFloat(a.avg);
            });

            const lowAvgUsers = rows.filter(r => r.avg !== '—' && parseFloat(r.avg) < 1.5);
            if (lowAvgUsers.length) {
                setTimeout(() => {
                    const modal = document.createElement('div'); modal.className = 'modal-overlay';
                    modal.innerHTML = `<div class="modal-content"><h3>⚠️ Низкий средний балл</h3><ul>${lowAvgUsers.map(r => `<li>${escapeHTML(r.user.fullName||r.user.name)} — ${r.avg}</li>`).join('')}</ul><button class="btn btn-primary" onclick="this.closest('.modal-overlay').remove()">ОК</button></div>`;
                    document.body.appendChild(modal);
                    modal.onclick = e => { if(e.target === modal) modal.remove(); };
                }, 200);
            }

            const isAdmin = getSession()?.role === 'admin';
            return `
            <div class="table-wrapper"><table>
                <thead><tr><th>№</th><th>Участник</th><th>Округ</th><th>Средний балл</th><th>Оценок</th></tr></thead>
                <tbody>${rows.map((r,i) => `<tr>
                    <td>${i+1}</td>
                    <td>${escapeHTML(r.user.fullName||r.user.name)}</td>
                    <td>${escapeHTML(r.user.district||'—')}</td>
                    <td class="${!isAdmin && r.avg !== '—' && parseFloat(r.avg) < 1.5 ? 'blurred' : ''}">${r.avg}</td>
                    <td>${r.count}</td>
                </tr>`).join('')}</tbody>
            </table></div>`;
        }

        const html = `
        <div class="card">
            <div class="card-header">
                <span>📈 Сводка (только участники с оценками)</span>
                <div style="display:flex;align-items:center;gap:10px;">
                    <label>Округ:</label>
                    <select id="summaryDistrictFilter" style="padding:6px 12px;border-radius:20px;">${districtOptions}</select>
                </div>
            </div>
            <div id="summaryContent"></div>
        </div>`;

        setTimeout(() => {
            const filterDistrict = document.getElementById('summaryDistrictFilter');
            const contentDiv = document.getElementById('summaryContent');
            function refreshView() { contentDiv.innerHTML = buildRating(filterDistrict.value); }
            filterDistrict.addEventListener('change', refreshView);
            refreshView();
        }, 0);
        return html;
    }

