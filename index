    };

    window._setTaskStatus = function(taskId, status) {
        const completions = getTaskCompletions();
        const exist = completions.findIndex(c => c.taskId === taskId && c.userId === getSession().userId);
        if (exist >= 0) { completions[exist].status = status; completions[exist].date = new Date().toISOString(); }
        else completions.push({ id: genId(), taskId, userId: getSession().userId, status, date: new Date().toISOString() });
        saveTaskCompletions(completions);
