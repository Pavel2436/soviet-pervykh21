                <div class="form-group"><label>VK</label><input id="profVk" value="${escapeHTML(user.socialLinks?.vk||'')}"></div>
                <div class="form-group"><label>Макс</label><input id="profMax" value="${escapeHTML(user.socialLinks?.max||'')}"></div>
                <div class="form-group"><label>Округ</label><select id="profDistrict"><option>—</option>${DISTRICTS.map(d=>`<option ${user.district===d?'selected':''}>${d}</option>`).join('')}</select></div>
                <div class="form-group"><label>Дата вступления</label><input type="date" id="profJoinDate" value="${user.joinDate||''}"></div>
                <button class="btn btn-primary" type="submit">💾 Сохранить</button>
            </form>
        </div>
        <div class="card">
            <h4>📝 Мои посты</h4>
            <form id="postForm" class="form-row">
                <textarea id="postText" placeholder="Текст поста" required></textarea>
                <input id="postImages" placeholder="URL фото через запятую">
                <button class="btn btn-primary">Опубликовать</button>
            </form>
            ${myPosts.map(p => `
                <div class="post-card">
                    <p>${escapeHTML(p.text)}</p>
                    ${(p.images || '').split(/[,;]+/).map(url => url.trim() && `<img src="${escapeHTML(url.trim())}" class="gallery-img">`).join('')}
                    <small>${formatDate(p.date)}</small>
                    <button class="btn btn-sm" onclick="window._deletePost('${p.id}')">🗑</button>
                </div>`).join('')}
        </div>`;
    }

    window._deletePost = function(id) {
        const users = getUsers();
        const u = users.find(u => u.id === getSession().userId);
        u.posts = u.posts.filter(p => p.id !== id);
        saveUsers(users);
        renderDashboard();
    };

    function bindProfileEvents() {
        const profileForm = document.getElementById('profileForm');
        if (profileForm) {
            profileForm.onsubmit = e => {
                e.preventDefault();
                const users = getUsers();
                const user = users.find(u => u.id === getSession().userId);
                const newLogin = document.getElementById('profLogin').value.trim();
                if (users.some(u => u.id !== user.id && u.login === newLogin)) {
                    showToast('❌ Логин уже занят', 'error'); return;
                }
                user.login = newLogin;
                if (document.getElementById('profPassword').value) user.password = document.getElementById('profPassword').value;
                user.fullName = document.getElementById('profFullName').value.trim();
                user.email = document.getElementById('profEmail').value.trim();
                user.photoURL = document.getElementById('profPhotoURL').value.trim();
                user.socialLinks = {
                    tg: document.getElementById('profTg').value.trim(),
                    vk: document.getElementById('profVk').value.trim(),
                    max: document.getElementById('profMax').value.trim()
                };
                user.district = document.getElementById('profDistrict').value;
                user.joinDate = document.getElementById('profJoinDate').value;
                saveUsers(users);
                showToast('✅ Профиль обновлён', 'success');
                renderDashboard();
            };
        }
        const postForm = document.getElementById('postForm');
        if (postForm) {
            postForm.onsubmit = e => {
                e.preventDefault();
                const users = getUsers();
                const user = users.find(u => u.id === getSession().userId);
                if (!user.posts) user.posts = [];
                user.posts.push({
                    id: genId(),
                    text: document.getElementById('postText').value,
                    images: document.getElementById('postImages').value,
                    date: new Date().toISOString()
                });
                saveUsers(users);
                showToast('✅ Пост добавлен', 'success');
                renderDashboard();
            };
        }
    }

    // ====== СООБЩЕНИЯ ======
    function renderMessagesTab() {
        const users = getUsers().filter(u => u.id !== getSession().userId);
        return `
        <div class="sub-tabs" id="msgSubTabs">
            <button class="sub-tab-btn active" data-subtab="chat">💬 Личные</button>
            <button class="sub-tab-btn" data-subtab="announcements">📢 Объявления</button>
        </div>
        <div id="msgContent"></div>`;
    }

    function bindMessagesEvents() {
        const session = getSession();
        const currentUserId = session.userId;
        const users = getUsers().filter(u => u.id !== currentUserId);
        const subTabs = document.querySelectorAll('#msgSubTabs .sub-tab-btn');
        const contentDiv = document.getElementById('msgContent');
        let currentSub = 'chat';

        function renderChat() {
            contentDiv.innerHTML = `
            <div class="chat-container">
                <div class="user-list" id="chatUserList">
                    ${users.map(u => `<div class="user-list-item" data-uid="${u.id}">${escapeHTML(u.fullName||u.name)}</div>`).join('')}
                </div>
                <div class="chat-area" id="chatArea">
                    <div class="messages-box" id="messagesBox"></div>
                    <div class="form-row" style="margin:0;">
                        <input id="chatInput" placeholder="Сообщение..." style="flex:1;">
                        <button class="btn btn-primary" id="sendChatBtn">➤</button>
                    </div>
                </div>
            </div>`;
            let selectedUserId = null;
            const msgBox = document.getElementById('messagesBox');
            const chatInput = document.getElementById('chatInput');
            const sendBtn = document.getElementById('sendChatBtn');

            function loadMessages() {
                if (!selectedUserId) { msgBox.innerHTML = '<div style="color:var(--text-light);">Выберите собеседника</div>'; return; }
                const msgs = getMessages().filter(m =>
                    (m.from === currentUserId && m.to === selectedUserId) ||
                    (m.from === selectedUserId && m.to === currentUserId)
                ).sort((a,b) => new Date(a.date) - new Date(b.date));
                msgBox.innerHTML = msgs.map(m => {
                    const isMine = m.from === currentUserId;
                    return `<div class="msg ${isMine ? 'mine' : ''}"><div class="msg-text">${escapeHTML(m.text)}</div><div style="font-size:0.7rem;color:var(--text-light);">${formatDate(m.date)}</div></div>`;
                }).join('');
                msgBox.scrollTop = msgBox.scrollHeight;
            }

            document.getElementById('chatUserList').addEventListener('click', e => {
                const item = e.target.closest('.user-list-item');
                if (!item) return;
                selectedUserId = parseInt(item.dataset.uid);
                document.querySelectorAll('.user-list-item').forEach(el => el.style.background = '');
                item.style.background = 'var(--bg)';
                loadMessages();
            });

            sendBtn.onclick = () => {
                if (!selectedUserId || !chatInput.value.trim()) return;
                const msgs = getMessages();
                msgs.push({ id: genId(), from: currentUserId, to: selectedUserId, text: chatInput.value.trim(), date: new Date().toISOString() });
                saveMessages(msgs);
                chatInput.value = '';
                loadMessages();
            };
        }

        function renderAnnouncements() {
            const announcements = getAnnouncements().sort((a,b) => new Date(b.date) - new Date(a.date));
            let formHtml = '';
            if (session.role === 'admin') {
                formHtml = `
                <div class="card"><form id="announcementForm" class="form-row">
                    <div class="form-group"><label>Тема</label><input id="annSubject" required></div>
                    <div class="form-group"><label>Сообщение</label><textarea id="annMessage" required></textarea></div>
                    <button class="btn btn-primary" type="submit">📢 Опубликовать рассылку</button>
                </form></div>`;
            }
            contentDiv.innerHTML = formHtml + announcements.map(a => `
                <div class="card">
                    <strong>${escapeHTML(a.subject)}</strong>
                    <p>${escapeHTML(a.message)}</p>
                    <small>${formatDate(a.date)}</small>
                </div>`).join('') || '<div class="empty-state">Нет объявлений</div>';
            const annForm = document.getElementById('announcementForm');
            if (annForm) {
                annForm.onsubmit = e => {
                    e.preventDefault();
                    const anns = getAnnouncements();
                    anns.push({
                        id: genId(),
                        subject: document.getElementById('annSubject').value,
                        message: document.getElementById('annMessage').value,
                        from: currentUserId,
                        date: new Date().toISOString()
                    });
                    saveAnnouncements(anns);
                    showToast('📢 Рассылка опубликована', 'success');
                    renderDashboard();
                };
            }
        }

        subTabs.forEach(btn => {
            btn.addEventListener('click', function() {
                subTabs.forEach(b => b.classList.remove('active'));
                this.classList.add('active');
                currentSub = this.dataset.subtab;
                if (currentSub === 'chat') renderChat();
                else renderAnnouncements();
            });
        });
        renderChat();
    }
  
    function checkUnseenNotifications(userId) {
        const notifications = getNotifications().filter(n => !n.seenBy.includes(userId) && (!n.targetUserId || n.targetUserId == userId));
        if (notifications.length) {
            const msg = notifications.map(n => n.message).join('\n');
            const overlay = document.createElement('div'); overlay.className = 'modal-overlay';
            overlay.innerHTML = `<div class="modal-content"><h3>📢 Новое задание</h3><p>${escapeHTML(msg)}</p><button class="btn btn-primary" id="closeNotif">ОК</button></div>`;
            document.body.appendChild(overlay);
            overlay.querySelector('#closeNotif').onclick = () => {
                notifications.forEach(n => n.seenBy.push(userId));
                saveNotifications(getNotifications().map(n => notifications.includes(n) ? {...n} : n));
                overlay.remove();
            };
            overlay.onclick = e => { if(e.target === overlay) overlay.remove(); };
        }
    }

    function bindTabEvents(idx) {
        const tabText = document.querySelectorAll('.tab-btn')[idx]?.textContent || '';
        if (tabText.includes('Оценки')) bindGradesEvents();
        else if (tabText.includes('Новости')) bindNewsEvents();
        else if (tabText.includes('Задания')) bindTasksEvents();
        else if (tabText.includes('Обратная связь')) bindFeedbackEvents();
        else if (tabText.includes('Пользователи')) bindUsersEvents();
        else if (tabText.includes('Округа')) bindDistrictsEvents();
        else if (tabText.includes('Лидерство')) bindLeaderEvents();
        else if (tabText.includes('Чат направления')) bindDirectionChatEvents();
        else if (tabText.includes('Профиль')) bindProfileEvents();
        else if (tabText.includes('Сообщения')) bindMessagesEvents();
    }

    window._logout = () => { saveSession(null); renderLogin(); showToast('👋 Вы вышли'); };
    window._openSettingsModal = () => openSettingsModal();

    function openSettingsModal() {
        const s = getSettings(); const session = getSession();
        const modal = document.createElement('div'); modal.className = 'modal-overlay';
        let adminButtons = '';
        if (session?.role === 'admin') {
            adminButtons = `
                <div style="margin:20px 0;">
                    <button class="btn btn-primary" id="exportBtn">📥 Экспорт JSON</button>
                    <input type="file" id="importFile" accept=".json" style="display:none;">
                    <button class="btn btn-primary" id="importBtn">📤 Импорт JSON</button>
                    <button class="btn btn-primary" id="exportExcelBtn">📊 Экспорт Excel</button>
                    <button class="btn btn-success" id="addMissingBtn">➕ Добавить недостающих (до 150)</button>
                </div>`;
        }
        modal.innerHTML = `
            <div class="modal-content">
                <h3>⚙️ Настройки</h3>
                <div style="margin:20px 0;"><label>Тема:</label><div style="display:flex;gap:10px;margin-top:8px;"><div class="theme-option" data-theme="light" style="padding:10px 20px;border-radius:20px;background:${s.theme==='light'?'var(--primary)':'var(--bg)'};">Светлая</div><div class="theme-option" data-theme="dark" style="padding:10px 20px;border-radius:20px;background:${s.theme==='dark'?'var(--primary)':'var(--bg)'};">Тёмная</div></div></div>
                <div style="margin:20px 0;"><label>Цвет:</label><div style="display:flex;gap:10px;margin-top:8px;"><div class="color-option" data-color="red" style="width:40px;height:40px;border-radius:50%;background:#D4002A;"></div><div class="color-option" data-color="blue" style="width:40px;height:40px;border-radius:50%;background:#0039A6;"></div><div class="color-option" data-color="white" style="width:40px;height:40px;border-radius:50%;background:#FFF;"></div></div></div>
                ${adminButtons}
                <button class="btn btn-primary" onclick="this.closest('.modal-overlay').remove()">Закрыть</button>
            </div>`;
        document.body.appendChild(modal);
        modal.querySelectorAll('.theme-option').forEach(b => b.onclick = () => { s.theme = b.dataset.theme; saveSettings(s); applySettings(s); modal.remove(); renderDashboard(); });
        modal.querySelectorAll('.color-option').forEach(c => c.onclick = () => { s.primaryColor = c.dataset.color; saveSettings(s); applySettings(s); modal.remove(); renderDashboard(); });
        if (session?.role === 'admin') {
            modal.querySelector('#exportBtn').onclick = () => {
                const data = { users: getUsers(), grades: getGrades(), news: getNews(), tasks: getTasks(), taskCompletions: getTaskCompletions(), feedback: getFeedback(), disputes: getDisputes(), notifications: getNotifications(), settings: getSettings(), messages: getMessages(), announcements: getAnnouncements(), districts: DISTRICTS, directionChatMembers: getDirectionChatMembers() };
                const blob = new Blob([JSON.stringify(data, null, 2)], {type: 'application/json'});
                const a = document.createElement('a'); a.href = URL.createObjectURL(blob); a.download = 'backup_' + new Date().toISOString().slice(0,10) + '.json'; a.click();
                showToast('📥 Резервная копия сохранена', 'success');
            };
            modal.querySelector('#importBtn').onclick = () => modal.querySelector('#importFile').click();
            modal.querySelector('#importFile').onchange = (e) => {
                if(e.target.files[0]) {
                    const reader = new FileReader();
                    reader.onload = async function(ev) {
                        try {
                            const data = JSON.parse(ev.target.result);
                            for (let key of Object.keys(data)) {
                                if (key === 'districts') { DISTRICTS = data.districts; await saveCache('districts', DISTRICTS); }
                                else if (key === 'directionChatMembers') { await saveDirectionChatMembers(data.directionChatMembers); }
                                else if (cache[key] !== undefined) await saveCache(key, data[key]);
                            }
                            applySettings(getSettings());
                            showToast('📤 Данные восстановлены', 'success'); location.reload();
                        } catch(e) { showToast('❌ Ошибка импорта', 'error'); }
                    };
                    reader.readAsText(e.target.files[0]);
                }
                modal.remove();
            };
            modal.querySelector('#exportExcelBtn').onclick = () => {
                const grades = getGrades(); const users = getUsers();
                let html = '<html><head><meta charset="UTF-8"></head><body><table border="1"><tr><th>Дата</th><th>Участник</th><th>Округ</th><th>Категория</th><th>Направление</th><th>Оценка</th><th>Описание</th></tr>';
                grades.forEach(g => { const u = users.find(u => u.id === g.userId); html += `<tr><td>${formatDate(g.date)}</td><td>${u?.fullName||u?.name||''}</td><td>${u?.district||''}</td><td>${g.category||''}</td><td>${g.direction||''}</td><td>${g.grade}</td><td>${g.description||''}</td></tr>`; });
                html += '</table></body></html>'; const blob = new Blob([html], {type: 'application/vnd.ms-excel'}); const a = document.createElement('a'); a.href = URL.createObjectURL(blob); a.download = 'grades_export.xls'; a.click(); showToast('📊 Оценки экспортированы в Excel', 'success');
            };
            modal.querySelector('#addMissingBtn').onclick = () => {
                modal.remove();
                addMissingUsers().then(result => {
                    if (result.addedAdmins > 0 || result.addedUsers > 0) {
                        setTimeout(() => location.reload(), 1500);
                    }
                });
            };
        }
        modal.onclick = e => { if(e.target === modal) modal.remove(); };
    }

    async function init() {
        await initializeData();
        applySettings(getSettings());
        const session = getSession();
        if (session && getUsers().find(u => u.id === session.userId)) renderDashboard();
        else renderLogin();
    }
    init();
</script>
</body>
</html>
