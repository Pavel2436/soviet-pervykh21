    window._disputeGrade = function(gradeId) {
        const reason = prompt('Причина оспаривания:');
        if (!reason) return;
        const disputes = getDisputes();
        disputes.push({ id: genId(), gradeId, userId: getSession().userId, reason, status: 'open', date: new Date().toISOString() });
        saveDisputes(disputes);
        showToast('⚠️ Оспаривание отправлено', 'success');
    };

    function bindGradesEvents() {
        const session = getSession();
        const user = getUsers().find(u => u.id === session.userId);
        if (user.role === 'admin') {
            const select = document.getElementById('gradeUserSelect');
            const form = document.getElementById('addGradeForm');
            if (!select || !form) return;
            select.onchange = () => {
                const grades = getGrades().filter(g => g.userId === parseInt(select.value)).sort((a,b)=>new Date(b.date)-new Date(a.date));
                const tbody = document.querySelector('.table-wrapper tbody');
                if (tbody) tbody.innerHTML = grades.map((g,i)=>`<tr><td>${i+1}</td><td>${escapeHTML(g.category||'')}</td><td><span class="grade-badge grade-${g.grade}">${g.grade}</span></td><td>${escapeHTML(g.description)}</td><td>${formatDate(g.date)}</td><td><button class="btn btn-sm" onclick="window._editGrade('${g.id}')">✏️</button> <button class="btn btn-danger btn-sm" data-gradeid="${g.id}">🗑</button></td></tr>`).join('');
            };
            form.onsubmit = e => {
                e.preventDefault();
                const grades = getGrades();
                grades.push({
                    id: genId(),
                    userId: parseInt(select.value),
                    grade: parseInt(document.getElementById('gradeVal').value),
                    category: document.getElementById('gradeCategory').value,
                    description: document.getElementById('gradeDesc').value.trim(),
                    date: document.getElementById('gradeDate').value + 'T00:00:00',
                    direction: document.getElementById('gradeCategory').value === 'Работа в направлении' ? 'Общая' : ''
                });
                saveGrades(grades);
                showToast('✅ Оценка добавлена', 'success');
                select.dispatchEvent(new Event('change'));
                document.getElementById('gradeDesc').value = '';
            };
            document.body.addEventListener('click', e => {
                if (e.target.classList.contains('btn-danger') && e.target.dataset.gradeid) {
                    if (confirm('Удалить?')) {
                        saveGrades(getGrades().filter(g => g.id !== e.target.dataset.gradeid));
                        select.dispatchEvent(new Event('change'));
                    }
                }
            });
        }
    }

