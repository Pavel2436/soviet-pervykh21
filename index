    function renderTasksTab() {
        const session = getSession();
        const user = getUsers().find(u => u.id === session.userId);
        const tasks = getTasks().sort((a,b)=>new Date(b.date)-new Date(a.date));
        const completions = getTaskCompletions();
        if (user.role === 'admin') {
            const allUsers = getUsers().filter(u => u.role === 'user');
            return `
            <div class="card"><div class="card-header">➕ Добавить задание</div>
                <form id="taskForm" class="form-row">
                    <div class="form-group"><label>Название</label><input id="taskTitle" required></div>
                    <div class="form-group"><label>Описание</label><input id="taskDesc" required></div>
                    <div class="form-group"><label>Ссылка</label><input id="taskLink"></div>
                    <div class="form-group"><label>Фото URL</label><input id="taskImage"></div>
                    <div class="form-group"><label>Видео URL</label><input id="taskVideo"></div>
                    <div class="form-group"><label>Текст уведомления</label><input id="taskNotify" placeholder="Увидят все или выбранный участник"></div>
                    <div class="form-group"><label>Назначить участнику</label><select id="taskAssignedTo"><option value="">Все</option>${allUsers.map(u => `<option value="${u.id}">${escapeHTML(u.fullName||u.name)}</option>`).join('')}</select></div>
                    <button type="submit" class="btn btn-primary">Опубликовать</button>
                </form>
            </div>
            ${tasks.map(task => {
                const done = completions.filter(c => c.taskId === task.id && c.status === 'done').length;
                const undone = completions.filter(c => c.taskId === task.id && c.status === 'undone').length;
                const assignedUser = task.assignedTo ? allUsers.find(u => u.id == task.assignedTo) : null;
                const detailsHtml = task.assignedTo ? '' : `<div style="margin-top:8px;"><strong>📊 Детали выполнения:</strong><ul>${allUsers.map(u => { const stat = completions.find(c=>c.taskId===task.id&&c.userId===u.id); return `<li>${escapeHTML(u.fullName||u.name)}: ${stat ? (stat.status==='done'?'✅ Выполнено':'❌ Не выполнено') : '⏳ Ожидает'}</li>`; }).join('')}</ul></div>`;
                return `<div class="card">
                    <strong>${escapeHTML(task.title)}</strong> ${assignedUser ? `<span style="background:var(--bg); padding:2px 8px; border-radius:10px;">👤 ${escapeHTML(assignedUser.fullName||assignedUser.name)}</span>` : '<span style="background:var(--bg); padding:2px 8px; border-radius:10px;">👥 Всем</span>'}
                    <p>${escapeHTML(task.description)}</p>
                    ${task.image ? `<img src="${escapeHTML(task.image)}" style="max-width:180px;">` : ''}
                    ${task.video ? `<video controls width="280"><source src="${escapeHTML(task.video)}"></video>` : ''}
                    <div>✅ ${done} | ❌ ${undone}</div>
                    ${detailsHtml}
                    <button class="btn btn-sm" onclick="window._editTask('${task.id}')">✏️</button>
                    <button class="btn btn-danger btn-sm" onclick="window._deleteTask('${task.id}')">🗑</button>
                </div>`;
            }).join('') || '<div class="empty-state">Нет заданий</div>'}`;
        } else {
            const myTasks = tasks.filter(task => !task.assignedTo || task.assignedTo == user.id);
            return myTasks.map(task => {
                const my = completions.find(c => c.taskId === task.id && c.userId === user.id);
                let statusHtml = '';
                if (my) {
                    statusHtml = my.status === 'done' ? '<span class="status-done">✅ Выполнено</span>' : '<span class="status-undone">❌ Не выполнено</span>';
                } else {
                    statusHtml = `<button class="btn btn-success btn-sm" onclick="window._setTaskStatus('${task.id}','done')">✅ Выполнено</button> <button class="btn btn-warning btn-sm" onclick="window._setTaskStatus('${task.id}','undone')">❌ Не выполнено</button>`;
                }
                return `<div class="card"><strong>${escapeHTML(task.title)}</strong><p>${escapeHTML(task.description)}</p>${statusHtml}</div>`;
            }).join('') || '<div class="empty-state">Нет заданий</div>';
        }
    }

